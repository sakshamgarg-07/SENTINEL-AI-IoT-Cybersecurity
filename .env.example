# ==============================================================================
# SENTINEL AI — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure with your specific environment credentials.
# WARNING: NEVER commit the active .env file or real credentials to Git/GitHub.

# --- MQTT Broker / HiveMQ Cloud Settings ---
MQTT_BROKER=your-hivemq-broker-host.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
TELEMETRY_TOPIC=p310/iot/telemetry
ALERT_TOPIC=p310/iot/alerts
PUBLISH_INTERVAL=2

# --- PostgreSQL Relational Storage Settings ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=p310_iot_security
PG_USER=postgres
PG_PASSWORD=your_postgres_password

# --- Machine Learning Model & Real Dataset Paths ---
MODEL_FILE=models/ton_iot_isolation_forest.joblib
REAL_DATASET=data/TON_IoT_Weather.csv
